{
  "schema_version": 1,
  "name": "Rudin_Modified_M",
  "description": "种子=Rudin2004；变异点=修改乘数M为(V-1)形式以改变几何收缩率。",
  "m": 4,
  "params": [
    {
      "name": "V",
      "value": 0.72
    }
  ],
  "defs": [
    {
      "name": "M",
      "expr": "V-0.5"
    }
  ],
  "solve": [
    {
      "name": "V",
      "equation": "4*V**3-12*V**2+9*V-2",
      "guess": 0.72
    }
  ],
  "recurrence": {
    "init": {
      "S": "1",
      "A": "1/(2*V)",
      "B": "(1-A-M*A)/3"
    },
    "step": {
      "S": "M*A",
      "A": "(A-2*B)/4",
      "B": "(S-A-M*A)/3"
    },
    "until": "A/S >= V",
    "max_iter": 60
  },
  "layers": [
    {
      "loop": {
        "var": "i",
        "from": 0,
        "to": "n"
      },
      "emit": [
        {
          "repeat": 4,
          "size": "B"
        },
        {
          "repeat": 3,
          "size": "A"
        },
        {
          "repeat": 1,
          "size": "where(i==n, S-A, A+2*A_next)"
        }
      ]
    }
  ],
  "final": [
    {
      "repeat": 1,
      "size": "2*A_first"
    }
  ],
  "order": "rev"
}