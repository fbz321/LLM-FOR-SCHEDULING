{
  "schema_version": 1,
  "name": "Rudin_Init_Scale",
  "description": "种子=Rudin2004；变异点=初始状态S缩放为V的二次函数以调整收敛速度。",
  "m": 4,
  "params": [
    {
      "name": "V",
      "value": 0.731
    }
  ],
  "defs": [
    {
      "name": "M",
      "expr": "(3*V-2)/2"
    },
    {
      "name": "S_init",
      "expr": "V**2+0.1"
    }
  ],
  "solve": [
    {
      "name": "V",
      "equation": "V**3+V**2-2*V+0.5",
      "guess": 0.731
    }
  ],
  "recurrence": {
    "init": {
      "S": "S_init",
      "A": "S_init/(2*V)",
      "B": "(S_init-A-M*A)/3"
    },
    "step": {
      "S": "M*A",
      "A": "(A-2*B)/4",
      "B": "(S-A-M*A)/3"
    },
    "until": "A/S >= V",
    "max_iter": 60
  },
  "layers": [
    {
      "loop": {
        "var": "i",
        "from": 0,
        "to": "n"
      },
      "emit": [
        {
          "repeat": 4,
          "size": "B"
        },
        {
          "repeat": 3,
          "size": "A"
        },
        {
          "repeat": 1,
          "size": "where(i==n, S-A, A+2*A_next)"
        }
      ]
    }
  ],
  "final": [
    {
      "repeat": 1,
      "size": "2*A_first"
    }
  ],
  "order": "rev"
}