    },
    {
      "name": "y",
      "expr": "(3-2*c)/(2-c)"
    }
  ],
  "solve": [
    {
      "name": "c",
      "equation": "c**4-6*c**3+10*c**2-6*c+1",
      "guess": 1.732
    }
  ],
  "recurrence": null,
  "layers": [
    {
      "emit": [
        {
          "repeat": 4,
          "size": "1-x"
        }
      ]
    },
    {
      "emit": [
        {
          "repeat": 4,
          "size": "x"
        }
      ]
    },
    {
      "emit": [
        {
          "repeat": 4,
          "size": "y"
        }
      ]
    },
    {
      "emit": [
        {
          "repeat": 4,
          "size": "x*y"
        }
      ]
    },
    {
      "emit": [
        {
          "repeat": 3,
          "size": "(1-y)*x"
        }
      ]
    },
    {
      "emit": [
        {
          "repeat": 1,
          "size": "c-1"
        }
      ]
    }
  ],
  "final": [
