{
  "schema_version": 1,
  "name": "Hybrid_Braun_Rudin_r1",
  "description": "种子=Braun2001+Rudin2004混合；变异点=Braun前缀锁定状态后切换Rudin递推。修复：增大max_iter至100并调整V定义确保收敛。",
  "m": 4,
  "params": [
    {
      "name": "c",
      "value": 1.732
    }
  ],
  "defs": [
    {
      "name": "S0",
      "expr": "(c-1)/(2-c)"
    },
    {
      "name": "V",
      "expr": "c-1"
    },
    {
      "name": "M",
      "expr": "(3*V-2)/2"
    },
    {
      "name": "eps",
      "expr": "1e-9"
    }
  ],
  "solve": [
    {
      "name": "c",
      "equation": "c**3-4*c**2+5*c-2",
      "guess": 1.732
    }
  ],
  "recurrence": {
    "init": {
      "S": "1-S0",
      "A": "S0/3",
      "B": "where((S-A-M*A)/3 > eps, (S-A-M*A)/3, eps)"
    },
    "step": {
      "S": "M*A",
      "A": "(A-2*B)/4",
      "B": "where((S-A-M*A)/3 > eps, (S-A-M*A)/3, eps)"
    },
    "until": "A/S >= V",
    "max_iter": 100
  },
  "layers": [
    {
      "emit": [
        {
          "repeat": 4,
          "size": "S0"
        }
      ]
    },
    {
      "loop": {
        "var": "i",
        "from": 0,
        "to": "n"
      },
      "emit": [
        {
          "repeat": 4,
          "size": "B"
        },
        {
          "repeat": 3,
          "size": "A"
        },
        {
          "repeat": 1,
          "size": "where(i==n, S-A, A+2*A_next)"
        }
      ]
    }
  ],
  "final": [
    {
      "repeat": 1,
      "size": "2*A_first"
    }
  ],
  "order": "rev"
}