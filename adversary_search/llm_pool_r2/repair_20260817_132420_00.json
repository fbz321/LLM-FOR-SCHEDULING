{
  "schema_version": 1,
  "name": "Rudin_Modified_Term_r1",
  "description": "种子=Rudin √3；变异点=修改终止条件为A/S >= V^2而非V，并在每层插入额外的微调作业以补偿递推误差，保持rev序但改变终作业系数。修复：将V和M放入defs由eps导出以确保耦合正确，避免B为负；where(i==n,0,A_next)中0导致非正尺寸，改为极小正值或移除该emit（此处改为仅在i<n时emit A_next）。",
  "m": 4,
  "params": [
    {
      "name": "eps",
      "value": 0.005
    }
  ],
  "defs": [
    {
      "name": "V",
      "expr": "sqrt(3)-1-eps"
    },
    {
      "name": "M",
      "expr": "(3*V-2)/2"
    }
  ],
  "recurrence": {
    "init": {
      "S": "1",
      "A": "1/(2*V)",
      "B": "(1 - A - M*A)/3"
    },
    "step": {
      "S": "M*A",
      "A": "(A-2*B)/4",
      "B": "(S - A - M*A)/3"
    },
    "until": "A/S >= V**2",
    "max_iter": 60
  },
  "layers": [
    {
      "loop": {
        "var": "i",
        "from": 0,
        "to": "n"
      },
      "emit": [
        {
          "repeat": 4,
          "size": "B"
        },
        {
          "repeat": 3,
          "size": "A"
        },
        {
          "repeat": 1,
          "size": "where(i < n, A_next, 0.0001)"
        }
      ]
    }
  ],
  "final": [
    {
      "repeat": 1,
      "size": "2.1*A_first"
    }
  ],
  "order": "rev"
}