{
  "schema_version": 1,
  "name": "Rudin_B_Collapse_r1",
  "description": "种子=Rudin2004；变异点=强制B层在特定深度坍缩为零，简化层结构。修复：移除导致负值的where条件分支，改用abs保护或调整阈值使B非负；此处改为始终计算标准B并依赖until自然终止。",
  "m": 4,
  "params": [
    {
      "name": "V",
      "value": 0.73
    }
  ],
  "defs": [
    {
      "name": "M",
      "expr": "(3*V-2)/2"
    }
  ],
  "solve": [
    {
      "name": "V",
      "equation": "V**2+2*V-2",
      "guess": 0.732
    }
  ],
  "recurrence": {
    "init": {
      "S": "1",
      "A": "1/(2*V)",
      "B": "(1-A-M*A)/3"
    },
    "step": {
      "S": "M*A",
      "A": "(A-2*B)/4",
      "B": "(S-A-M*A)/3"
    },
    "until": "A/S >= V",
    "max_iter": 60
  },
  "layers": [
    {
      "loop": {
        "var": "i",
        "from": 0,
        "to": "n"
      },
      "emit": [
        {
          "repeat": 4,
          "size": "B"
        },
        {
          "repeat": 3,
          "size": "A"
        },
        {
          "repeat": 1,
          "size": "where(i==n, S-A, A+2*A_next)"
        }
      ]
    }
  ],
  "final": [
    {
      "repeat": 1,
      "size": "2*A_first"
    }
  ],
  "order": "rev"
}