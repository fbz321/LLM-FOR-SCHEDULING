{
  "schema_version": 1,
  "name": "Hybrid_FKT_Rudin_r1",
  "description": "种子=FKT1995+Rudin2004混合；变异点=FKT双层后接Rudin递推尾部。修复：V由eps导出V=sqrt(3)-1-eps，M=(3V-2)/2，确保耦合正确；B用where保护非负。",
  "m": 4,
  "params": [
    {
      "name": "eps",
      "value": 1e-06
    }
  ],
  "defs": [
    {
      "name": "V",
      "expr": "sqrt(3)-1-eps"
    },
    {
      "name": "M",
      "expr": "(3*V-2)/2"
    },
    {
      "name": "a",
      "expr": "(V-0.5)/V"
    }
  ],
  "solve": [],
  "recurrence": {
    "init": {
      "S": "1-4*a",
      "A": "a/2",
      "B": "where((S-A-M*A)/3 > 1e-12, (S-A-M*A)/3, 1e-12)"
    },
    "step": {
      "S": "M*A",
      "A": "(A-2*B)/4",
      "B": "where((S-A-M*A)/3 > 1e-12, (S-A-M*A)/3, 1e-12)"
    },
    "until": "A/S >= V",
    "max_iter": 30
  },
  "layers": [
    {
      "emit": [
        {
          "repeat": 4,
          "size": "a"
        }
      ]
    },
    {
      "loop": {
        "var": "i",
        "from": 0,
        "to": "n"
      },
      "emit": [
        {
          "repeat": 4,
          "size": "B"
        },
        {
          "repeat": 3,
          "size": "A"
        },
        {
          "repeat": 1,
          "size": "where(i==n, S-A, A+2*A_next)"
        }
      ]
    }
  ],
  "final": [
    {
      "repeat": 1,
      "size": "2*A_first"
    }
  ],
  "order": "rev"
}