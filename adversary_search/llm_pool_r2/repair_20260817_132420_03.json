{
  "schema_version": 1,
  "name": "Rudin_Sqrt3_Std_r1",
  "description": "种子=Rudin2004；变异点=标准√3构造rev序，验证递推S'=M*A终止条件。修复：V和M必须由eps导出（V=sqrt(3)-1-eps, M=(3V-2)/2），原独立设V=0.732违反耦合致B负；现用eps=0.001确保B>0。",
  "m": 4,
  "params": [
    {
      "name": "eps",
      "value": 0.001
    }
  ],
  "defs": [
    {
      "name": "V",
      "expr": "sqrt(3)-1-eps"
    },
    {
      "name": "M",
      "expr": "(3*V-2)/2"
    }
  ],
  "recurrence": {
    "init": {
      "S": "1",
      "A": "1/(2*V)",
      "B": "(1-A-M*A)/3"
    },
    "step": {
      "S": "M*A",
      "A": "(A-2*B)/4",
      "B": "(S-A-M*A)/3"
    },
    "until": "A/S >= V",
    "max_iter": 60
  },
  "layers": [
    {
      "loop": {
        "var": "i",
        "from": 0,
        "to": "n"
      },
      "emit": [
        {
          "repeat": 4,
          "size": "B"
        },
        {
          "repeat": 3,
          "size": "A"
        },
        {
          "repeat": 1,
          "size": "where(i==n, S-A, A+2*A_next)"
        }
      ]
    }
  ],
  "final": [
    {
      "repeat": 1,
      "size": "2*A_first"
    }
  ],
  "order": "rev"
}