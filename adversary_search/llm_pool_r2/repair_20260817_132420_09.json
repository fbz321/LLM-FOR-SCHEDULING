{
  "schema_version": 1,
  "name": "Hybrid_Braun_Rudin_r1",
  "description": "种子=Braun2001+Rudin2004混合；变异点=Braun前缀锁定状态后切换Rudin递推。修复：c由6c^3-28c^2+38c-13=0解出，V=c-1，M=(3V-2)/2，确保所有尺寸为正。",
  "m": 4,
  "params": [],
  "defs": [
    {
      "name": "S0",
      "expr": "(c-1)/(2-c)"
    },
    {
      "name": "V",
      "expr": "c-1"
    },
    {
      "name": "M",
      "expr": "(3*V-2)/2"
    }
  ],
  "solve": [
    {
      "name": "c",
      "equation": "6*c**3-28*c**2+38*c-13",
      "guess": 1.731
    }
  ],
  "recurrence": {
    "init": {
      "S": "1-S0",
      "A": "S0/3",
      "B": "where((S-A-M*A)/3 > 1e-12, (S-A-M*A)/3, 1e-12)"
    },
    "step": {
      "S": "M*A",
      "A": "(A-2*B)/4",
      "B": "where((S-A-M*A)/3 > 1e-12, (S-A-M*A)/3, 1e-12)"
    },
    "until": "A/S >= V",
    "max_iter": 100
  },
  "layers": [
    {
      "emit": [
        {
          "repeat": 4,
          "size": "S0"
        }
      ]
    },
    {
      "loop": {
        "var": "i",
        "from": 0,
        "to": "n"
      },
      "emit": [
        {
          "repeat": 4,
          "size": "B"
        },
        {
          "repeat": 3,
          "size": "A"
        },
        {
          "repeat": 1,
          "size": "where(i==n, S-A, A+2*A_next)"
        }
      ]
    }
  ],
  "final": [
    {
      "repeat": 1,
      "size": "2*A_first"
    }
  ],
  "order": "rev"
}