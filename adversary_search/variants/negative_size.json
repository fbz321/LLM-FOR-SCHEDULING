{
  "schema_version": 1,
  "name": "negative size test",
  "description": "故意负尺寸，验证第 2 级拦截",
  "m": 4,
  "params": [ { "name": "a", "value": 1.5 } ],
  "defs": [ { "name": "b", "expr": "1 - a" } ],
  "layers": [ { "emit": [ { "repeat": 4, "size": "a" }, { "repeat": 4, "size": "b" } ] } ],
  "final": [ { "repeat": 1, "size": "1" } ],
  "order": "fwd"
}
